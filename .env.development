# Valores de `npm run dev`: Vite lee este archivo solo, no hay que copiarlo.
# Se versiona porque no tiene nada sensible (URLs públicas y el app id).
# NUNCA poner claves ni contraseñas acá: un secreto va en `.env`, que git ignora.
# Ver "VITE_API_URL por entorno" en src/GUIA_FRONT.md.

# El front llama al proxy server-side (sin CORS).
VITE_API_URL=/api/ords/
# App id por defecto para menu/paginas.
VITE_APP_ID=86972
